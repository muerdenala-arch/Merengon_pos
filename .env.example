# Copiá este archivo a .env.local y completá los valores reales (nunca commitees .env.local).
# Estas son las ÚNICAS 4 variables que el código lee — ver api/_lib/db.ts y api/_lib/cloudinary.ts.
# En Vercel: Settings → Environment Variables → agregalas con el checkbox "Production" tildado.

# Connection string de Postgres (Neon). Panel de Neon → tu proyecto → "Connection Details".
# Formato: postgresql://usuario:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Cloudinary → Dashboard → Settings → API Keys (o "Product Environment Credentials").
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firma las sesiones de login del staff (ver api/_lib/auth.ts). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
